# ---------------------------------------------------------------
# PDF Job Filler - Telegram bot settings
# Copy this file to ".env" (same folder) and fill in the values.
# ---------------------------------------------------------------

# From @BotFather in Telegram (/newbot)
BOT_TOKEN=123456789:AAAA-your-bot-token

# Your numeric Telegram user id (ask @userinfobot). Everyone else is ignored.
# Several ids: separate with commas.
ALLOWED_USER_ID=123456789

# Templates exported from the web app (Templates > Export). Just send the .json files to the bot;
# they are kept in this folder and the bot picks the best one for each PDF.
TEMPLATES_DIR=bot/data/templates
# Older single-template setups: this file is still used if it exists.
TEMPLATE_PATH=bot/data/template.json

# Optional: use this blank form instead of the one stored inside the template.
# FORM_PATH=C:\Users\Alex\Documents\forms\job-sheet.pdf

# Optional: a .ttf/.otf font for letters like ă â î ș ț (otherwise they become a, i, s, t).
# FONT_PATH=C:\Windows\Fonts\arial.ttf

# Optional: true / false. Empty = use the template's "Flatten by default".
FLATTEN=

# Send a picture of the filled page 1 with each result (true/false)
PREVIEW=true

# PDF metadata written into every output. An empty value removes the entry.
PDF_AUTHOR=Alex
PDF_CREATOR=
PDF_PRODUCER=
# Put the Job Name in the document Title (true/false)
TITLE_FROM_JOB_NAME=false
# Remove the form's old XMP metadata so viewers show the values above (true/false)
STRIP_XMP=true
