# Copy this file to .env and fill it in. Never share the real .env.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (from @userinfobot). Comma-separate several to allow more people.
TELEGRAM_CHAT_ID=

# Which image AI draws the pages:
#   free        = Cloudflare (if configured) then Pollinations as backup   ($0)
#   cloudflare  = Cloudflare Workers AI Flux, free 10k neurons/day (~170 pages/day)
#   pollinations= no key needed, slow (~1 image / 45 s without a key)
#   openai | gemini | fal  = paid
IMAGE_PROVIDER=free

# Cloudflare (free): dash.cloudflare.com -> AI -> Workers AI -> "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional free key from enter.pollinations.ai (faster, no logo)
POLLINATIONS_KEY=
# Optional, free tier at aistudio.google.com: used for book ideas
GEMINI_API_KEY=
# Paid options
OPENAI_API_KEY=
FAL_KEY=

# Tuning
PAGES=100
PAGE_SIZE=A4            # A4 or LETTER
AGE_GROUP=4-8
PARALLEL=3
# Send a new book automatically every N hours (0 = off)
AUTO_EVERY_HOURS=0
